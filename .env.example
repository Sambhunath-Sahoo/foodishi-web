# Base URL of the Foodishi FastAPI service. Every app reads this; nothing is
# hardcoded. Copy this file to .env.local in each app, or export it once.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase browser auth. Copy from the Foodishi API .env:
#   NEXT_PUBLIC_SUPABASE_URL      <- SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY <- SUPABASE_PUBLISHABLE_KEY
# Both are public by design. NEVER put SUPABASE_SECRET_KEY in a frontend app:
# it bypasses RLS entirely.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Data source: "fixtures" (bundled JSON, the default) or "api" (the FastAPI
# service). Read by apps/customer and apps/partner. The OPERATOR app ignores it
# and is fixtures-only: lib/services/index.ts wires fixtureServices
# unconditionally and there is no api/ implementation yet. This file used to say
# the operator console was "always on the API", which read as "already live"
# when the truth is "has no API path at all".
# Set it per app in apps/<app>/.env.local.
NEXT_PUBLIC_DATA_SOURCE=fixtures
